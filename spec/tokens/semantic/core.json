{
  "semantic": {
    "accent": {
      "$type": "color",
      "presets": {
        "dunting": {
          "dark": "#1e293bff",
          "light": "#dbe4f5ff"
        },
        "launcher": {
          "dark": "oklch(0.269 0 0)",
          "light": "oklch(0.97 0 0)"
        }
      }
    },
    "accent-foreground": {
      "$type": "color",
      "presets": {
        "dunting": {
          "dark": "#e6f0faff",
          "light": "#1c2430ff"
        },
        "launcher": {
          "dark": "oklch(0.985 0 0)",
          "light": "oklch(0.205 0 0)"
        }
      }
    },
    "background": {
      "$type": "color",
      "presets": {
        "dunting": {
          "dark": "#0a0c14ff",
          "light": "#f4f6faff"
        },
        "launcher": {
          "dark": "oklch(0.145 0 0)",
          "light": "oklch(1 0 0)"
        }
      }
    },
    "border": {
      "$type": "color",
      "presets": {
        "dunting": {
          "dark": "#3c4858ff",
          "light": "#ccd4e0ff"
        },
        "launcher": {
          "dark": "color-mix(in oklch, var(--foreground) 18%, transparent)",
          "light": "color-mix(in oklch, var(--foreground) 14%, transparent)"
        }
      }
    },
    "card": {
      "$type": "color",
      "presets": {
        "dunting": {
          "dark": "#161b26ff",
          "light": "#ffffffff"
