        "launcher": {
          "dark": "oklch(0.145 0 0)",
          "light": "oklch(1 0 0)"
        }
      }
    },
    "card-foreground": {
      "$type": "color",
      "presets": {
        "dunting": {
          "dark": "#e6f0faff",
          "light": "#1c2430ff"
        },
        "launcher": {
          "dark": "oklch(0.985 0 0)",
          "light": "oklch(0.145 0 0)"
        }
      }
    },
    "destructive": {
      "$type": "color",
      "presets": {
        "dunting": {
          "dark": "#FF3B30E6",
          "light": "#D12E26E6"
        },
        "launcher": {
          "dark": "oklch(0.62 0.22 27.325)",
          "light": "oklch(0.577 0.245 27.325)"
