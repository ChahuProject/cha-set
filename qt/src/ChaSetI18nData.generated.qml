out dimmed 50% opacity","ticksTitle":"Discrete Stops with Ticks","ticksDesc":"Quantized stops with tick indicators and label marks","disabledTitle":"Disabled State","disabledDesc":"Non-interactive with dimmed opacity for disabled controls","verticalTitle":"Vertical Orientation","verticalDesc":"Vertical layout for mixer channels and level meters","customRangeTitle":"Custom Range (20 to 80)","customRangeDesc":"Bounded custom minimum and maximum limits with step=5"},"rangeSlider":{"overviewDesc":"Drag either thumb to adjust minimum and maximum bounds.","minLabel":"Min: {{value}}","maxLabel":"Max: {{value}}","sizesAndStatesSubtitle":"Available in default and sm sizing tiers, with tooltips, read-only, and disabled states.","defaultWithTooltips":"Default with Tooltips","compactSm":"Compact sm Tier","readOnly":"Read Only","disabled":"Disabled"},"snapSlider":{"presetLabel":"Preset:","presetMin":"0.5x (Min)","presetNormal":"1.0x (Normal)","presetMax":"3.0x (Max)","slow":"Slow","fast":"Fast","animationsDesc":"Motion tokens and kinematic timing contracts for SnapSlider interaction."},"segmentedControl":{"grid":"Grid","list":"List","gallery":"Gallery","currentSelection":"Current selection: {{value}}","selectedValue":"Selected value: {{value}}","smDesc":"Small (sm - Menu & Toolbar dense)","defaultDesc":"Default (Standard controls)","lgDesc":"Large (lg - Prominent tabs style)","truncationSubtitle":"By default, segments auto-adapt to their content length. When equalWidth, fullWidth, or itemWidth is configured, segments enforce equal or fixed dimensions and truncate overflowing text with an ellipsis.","autoAdaptiveTitle":"Auto-Adaptive Content Width (Default)","fixedWidthTitle":"Fixed Width per Item with Ellipsis (itemWidth=110)","menuTitleSubtitle":"Supports an optional prefix title to seamlessly embed within context menu rows and parameter settings panels.","gridStyleTitle":"Grid Style:","gridPatternTitle":"Grid Pattern:","off":"Off","line":"Line","dot":"Dot","optShort":"Short","optVar":"Variable Length Title","optLong":"Long Description Tab","optCompact":"Compact","optFitComfortably":"Very Long Option Text That Fits Comfortably","optTruncate":"Very Long Option Text That Truncates","optSettings":"Settings"}},"getStarted":{"intro":{"title":"Introduction","philosophy":{"title":"Design Philosophy","desc":"ChaSet is part of the ChahuProject ecosystem. In traditional multi-platform apps, Web and Desktop design systems drift apart quickly. ChaSet solves this by establishing a neutral, machine-readable specification and token shard layer that drives both React and Qt simultaneously with pixel-perfect and behavioral parity.","oneSourceTitle":"One Source of Truth","oneSourceDesc":"Design tokens and API contracts reside in spec/ and emit synchronized tokens for Web & Qt.","nativeErgonomicsTitle":"Native Ergonomics","nativeErgonomicsDesc":"Tailwind CSS v4 & Base UI on React; pure QML Quick Controls on Qt — no electron bloat or foreign wrappers.","parityGateTitle":"Automated Parity Gate","parityGateDesc":"CI enforces that all required capabilities and visual rendering match 100% across stacks."},"architecture":{"title":"How It Works"},"quickstart":{"title":"Quick Start","titleReact":"Quick Start (React)","installDesc":"Install the package and peer dependencies:","useReactDesc":"Use in your React project:","useAppDesc":"Use in your application:","buttonText":"Launch Workspace"},"packages":{"title":"Packages","colPackage":"Package","colTarget":"Target","colDesc":"Description","pkgReactDesc":"React component library published to npm.","pkgQtDesc":"Qt reference implementation with native QML components.","pkgSpecDesc":"Neutral token generator and contract schemas."}},"tokens":{"palette":{"title":"Palette · Semantic Core Tokens","desc":"All derived from spec/tokens.json. Click any swatch to copy its CSS variable expression.","copySwatchTitle":"Click to copy CSS variable"},"typographyRadius":{"title":"Typography / Radius / Charts","desc":"Radii derived from --radius (same sm/md/lg/xl derivation as shadcn); font weights map to tokens.json primitives (500/600); chart five colors follow the accent.","radiusDefault":"0.5rem (Default)","fontSystemTitle":"Font System · CJK Fallback & Typography Scale","zeroSimSunBadge":"Zero-SimSun Guarantee","sansFallback":"Fallback Stack (Sans): ","monoFallback":"Fallback Stack (Mono): ","sampleRegular":"Regular 400 — ChaSet Component Library · Unified Cross-Stack Typography System (The quick brown fox jumps over the lazy dog 0123456789)","sampleMedium":"Medium 500 — ChaSet Component Library · Unified Cross-Stack Typography System (The quick brown fox jumps over the lazy dog 0123456789)","sampleSemibold":"Semibold 600 — ChaSet Component Library · Unified Cross-Stack Typography System (The quick brown fox jumps over the lazy dog 0123456789)","sampleBold":"Bold 700 — ChaSet Component Library · Unified Cross-Stack Typography System (The quick brown fox jumps over the lazy dog 0123456789)","codeComment1":"const fontSystem = ChaSet.FontSystem; // Automatically handles Chinese font fallback, eliminating SimSun aliasing","codeComment2":"console.log(`[ChaSet] CJK glyphs: Smooth and sharp glyphs, zero raster artifacts`);","chartPaletteTitle":"CHART PALETTE (FOLLOWS ACCENT)"}},"themeTuner":{"tuner":{"title":"Theme & Style Tuner","resetTooltip":"Reset all custom color overrides","copyConfig":"Copy Config","copyConfigTooltip":"Export theme configuration as CSS, Tailwind, or JSON","appearance":"APPEARANCE & MODE","accentPreset":"ACCENT THEME PRESET","cornerRadius":"CORNER RADIUS (--RADIUS)","radiusDefault":"0.5rem (Default)","radiusSharp":"0px (Sharp)","radiusPill":"24px (Pill)","liveColorOverrides":"LIVE COLOR OVERRIDES","primaryAction":"Primary Action","primaryText":"Primary Text","secondaryBg":"Secondary Bg","destructive":"Destructive","pageBackground":"Page Background","cardPanel":"Card / Panel","focusRing":"Focus Ring","motionTitle":"MOTION & ANIMATIONS","animSpeedFactor":"ANIMATION SPEED DURATION FACTOR","speedFast":"0.05s (Fast)","speedDefault":"0.20s (Default)","speedSlow":"0.80s (Slow)"},"playground":{"title":"Interactive Component Sandbox","titleQml":"Live Component Sandbox","desc":"Adjust props live, interact with the component, and copy ready-to-use code directly into your app.","descQml":"Interact with components rendering live under your current style settings:","variant":"Variant","buttons":"BUTTONS","size":"Size","buttonLabel":"Button Label","buttonPlaceholder":"Button text","defaultProjectLabel":"Create Project","defaultActionLabel":"Default Action","loadingState":"Loading State","fullWidth":"Full Width","renderAsLink":"Polymorphic (<a> link via Base UI)","clicks":"Clicks: {{count}}","loadingSpinnerActive":"Loading spinner active","jsxUsage":"React JSX Usage","copyJsx":"Copy JSX","miniScrollViewport":"MINI SCROLL VIEWPORT","viewportItem":"Item #{{index}}","disabled":"Disabled","outline":"Outline","secondary":"Secondary","danger":"Danger","ghostAction":"Ghost Action","linkAction":"Link Action","saving":"Saving..."}},"typography":{"rasterizer":{"title":"Rasterization Path","desc":"The two stacks reach the same glyph outlines through different rasterizers. Web asks Chromium for grayscale antialiasing with no grid fitting; Desktop resolves one policy for the whole process before the first window exists.","webCardTitle":"Web · Chromium","desktopCardTitle":"Desktop · Qt Quick","labelRasterizer":"Rasterizer","labelSmoothing":"Font smoothing","labelFitting":"Outline fitting","labelScale":"Interface scale","labelPolicies":"Policies","labelSubpixel":"Subpixel AA","labelHinting":"Hinting","webValRasterizer":"Grayscale alpha antialiasing","webValSmoothing":"antialiased · grayscale","webValFitting":"None — text shaper follows the outline","webValScale":"Root font size multiplier","qtValRasterizer":"Selected by CHASET_TEXT_RENDER","qtValPolicies":"qt (default) · native · curve","qtValSubpixel":"Disabled — grayscale only","qtValHinting":"Vertical only","qtValScale":"uiScale multiplier on every size token"},"ramp":{"title":"Cross-Script Size Ramp","desc":"Five script portals, each rendered once per type scale step. The passage never changes inside a block, so strokes can be compared across the whole ramp — including the rounded CJK and Hangul curves that reveal grid fitting first. Sizes follow the type scale and the interface scale, so they are named by token instead of by unit."},"integration":{"title":"Host Integration","desc":"How host applications configure and initialize ChaSet's typography subsystem across desktop and web runtimes.","desktopTitle":"Desktop · Qt Quick (C++ / QML)","desktopDesc":"Desktop applications initialize the typography system via ChaSet::FontSystem. Two calls in main.cpp configure DirectWrite pure alpha grayscale antialiasing, vertical hinting, and inject CJK fallback tables into QFontDatabase to eliminate bitmap SimSun degradation.","cmakeTitle":"1. CMake Target Linkage","cppTitle":"2. C++ Initialization (main.cpp)","envTitle":"3. Environment Variable Control (CHASET_TEXT_RENDER)","envDesc":"The window-level text rasterization policy is controlled dynamically before startup via the CHASET_TEXT_RENDER environment variable:","envQt":"qt (default): Qt glyph outline rasterizer (QtTextRendering). Smooth grayscale outline coverage without OS pixel grid-fitting; curves remain smooth when scaled.","envNative":"native: Operating-system rasterizer (DirectWrite / CoreText, NativeTextRendering). Crisp pixel-grid fitting for small upright text; staircasing on curves when scaled.","envCurve":"curve: Hardware GPU curve rasterizer (CurveTextRendering, Qt 6.7+). Scale-invariant GPU curve rendering; automatically degrades to qt when a software rasterizer is active.","webTitle":"Web · Chromium (React / CSS)","webDesc":"Web applications in Chromium / browsers automatically inherit grayscale antialiasing (-webkit-font-smoothing: antialiased) and CJK fallback chains through CSS variables. Environment variables and C++ initialization do not apply to the Web stack.","cssTokensTitle":"CSS Tokens & Font Family Overrides","cssTokensDesc":"Reference var(--cs-font-sans) and var(--cs-font-mono) when customizing font stacks to preserve the prioritized Chinese fallback chain:"}},"icons":{"specification":{"title":"Active Specification","desc":"Icons are declared once in spec/icons/registry.json and code-generated into both stacks. React renders the element vocabulary natively; Qt receives the same shapes compiled to path data. Neither stack owns artwork of its own, which is what makes the two platforms agree by construction rather than by review.","iconsCount":"{{count}} icons","rowGrid":"Grid","rowLive":"Live area","rowStroke":"Stroke","rowFill":"Fill policy","rowTolerance":"Centring tolerance","rowColour":"Colour","rowResolved":"Resolved through","valGrid":"{{grid}} units","valLive":"{{liveArea}} units (safe margin {{margin}})","valStroke":"{{strokeWidth}} units, {{linecap}} caps, {{linejoin}} joins","valTolerance":"{{tolerance}} units"},"rules":{"title":"Governance Rules","desc":"Each rule below is enforced by pnpm check:icons, which also runs inside pnpm gate. A rule that is not machine-checked would only be a slogan, so the enforcement column names the assertion that fails."},"grids":{"title":"Grids, Weight & Size","desc":"A grid pairs a drawing box with the stroke width that box expects, and states the render size it was drawn for. Two grids are declared: the default 24-unit grid for UI icons, drawn for a 16px render, and a dense 10-unit chrome grid whose 1-unit stroke stays hairline on window captions instead of collapsing to a sub-pixel smear.","gridBadge":"{{size}} units · stroke {{strokeWidth}}","safeMargin":"safe margin {{margin}}","drawnFor":"drawn for {{renderSize}}px → {{stroke}}px stroke","floor":"floor {{size}} / {{strokeWidth}} = {{floor}}px","gridDesc":"{{renderSize}}px is the size this grid was drawn for, where its stroke paints {{stroke}}px — the weight the artwork was proportioned to carry. Under {{floor}}px that stroke is under a pixel and the glyph ships lighter than its artwork declares, so the steps this grid is honest at are {{sizes}}. A size outside that list is not a smaller icon, it is a lighter one — measured rather than banned, because a 2x display forgives it, so the gate lists every reference below its floor and each one is a decision instead of an accident.","familiesTitle":"Control families","familiesDeclared":"{{count}} declared","familiesDesc":"A family names icons that render together inside one control. Their grid is then a promise about the control rather than about any single icon, which is what the caption close button broke: every icon involved was individually valid, and the row was still wrong. The gate asserts that no family spans two grids.","unitGridBadge":"{{size}} unit grid","weightTitle":"Weight","weightPermitted":"{{count}} permitted","weightStrokePrefix":"stroke {{strokeWidth}} — ","sizeRampTitle":"Size ramp — one icon, every step of the scale, no hand scaling","webLabel":"Web · {{size}}","desktopLabel":"Desktop · {{size}}"},"centering":{"title":"Optical Centring","desc":"Centring is a property of the geometry, not something a component fixes afterwards. The gate measures the painted bounding box (artwork plus half the stroke) and fails when its centre drifts more than {{tolerance}} units from the grid centre. Anchors offsets and padding are deliberately not an accepted fix: they centre a box, not the ink inside it.","osdTrioTitle":"The Scale OSD control trio","osdTrioDesc":"These three controls used to be typography: a bold plus, a bold minus sign and a regular reset arrow. Besides the mixed weight, a font's ascent and descent are not symmetric, so the arrow inherited a baseline that pushed it visibly low inside its pill. They are now three icons from this specification — same stroke, same grid, centred by geometry.","measuredOffsetsTitle":"Measured offsets — painted centre minus grid centre, in grid units"},"gallery":{"title":"Icon Gallery","desc":"Every icon of the active specification, rendered by name from the generated registry. Adding an icon to the registry makes it appear here on both stacks at once, and the gate refuses a name that has no geometry behind it.","searchPlaceholder":"Search icons by name..."},"configuration":{"title":"External Configuration","desc":"A host that wants the whole of ChaSet pinned to one specification does not edit the library. It declares the id externally; the generator bakes the resolved id into both artifacts, so the choice is observable at runtime through ICON_SPEC_ID (web) and ChaSetIcons.specId (desktop).","resolutionOrder":"Resolution order","firstMatchWins":"first match wins","stepEnvLabel":"Environment variable CHASET_ICON_SPEC","stepEnvVal":"Highest priority — per shell, per CI job, no file edit.","stepConfigLabel":"chaset.config.json → icons.spec","stepConfigVal":"Project-level switch; committed, so the choice travels with the repository.","stepRegistryLabel":"spec/icons/registry.json → activeSpec","stepRegistryVal":"Library-level default when the host declares nothing.","stepFallbackLabel":"First implemented specification","stepFallbackVal":"Last resort, so a missing switch never breaks a build.","currentlyResolved":"Currently resolved through {{source}}.","projectConfigFile":"Project configuration file","projectConfigDesc":"Commit this next to your package manifest to pin the specification for everyone building the project.","envOverride":"Environment override","envOverrideDesc":"Useful for CI matrices that build the same sources under several specifications.","consumingIcons":"Consuming icons"},"extensibility":{"title":"Extending the Specification","desc":"The registry holds a list of specifications, not a single hard-coded one. A new specification is a new entry with its own grid, stroke and artwork; nothing in either stack needs to change, because both consume whichever entry the configuration selects.","workflow":"Workflow","adoptionRatchet":"Adoption ratchet","adoptionRatchetDesc":"{{total}} hand-authored <svg> site(s) remain in the frozen migration backlog against a budget of {{budget}}. The gate fails when that number grows, so the backlog can only shrink.","textGlyphsTitle":"Text glyphs used as icons","textGlyphsDesc":"{{count}} remaining. Characters such as plus, minus sign and the reset arrow are typography: they inherit weight, size and baseline from surrounding copy — the mechanism behind both defects this specification was written to remove.","excusedTitle":"Excused as non-iconography ({{total}})","excusedNone":"None. Every inline artwork site in the repository owes a migration.","excusedFootnote":"Parametric vector art has no 24-grid stroke representation, so leaving it inside the budget would make the budget permanently unreachable. It is excluded instead — visibly, and only through a marker that carries a reason and must sit directly above the artwork it excuses. A marker that is unreasoned, dangling, or not attached to a following <svg> fails the gate."}}},"overlays":{"dialog":{"openProfile":"Open Profile Dialog","editProfileTitle":"Edit profile","editProfileDesc":"Make changes to your profile here. Click save when you're done.","name":"Name","username":"Username","currentProfile":"Current profile: {{name}} ({{username}})","desktopDraggableTitle":"Desktop Draggable Modal","desktopDraggableDesc":"Draggable modal with size presets, auto-fitting height, and fixed footer.","openDraggableWindow":"Open Draggable Window","advancedDesktopTitle":"Advanced Desktop Tool","advancedDesktopDesc":"Drag the title bar or window body to reposition. Switch size presets from the top-right button.","fixedFooterDesc":"The bottom actions area is extracted as a fixed footer that stays pinned during vertical scrolling.","confirm":"Confirm","adjustSize":"Adjust window size","presetCompact":"Compact","presetFullscreen":"Fullscreen","destructiveConfirmationTitle":"Destructive Con